<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Exporting the service and receiver lets adb fire an athan
  on demand so the whole playback / vibration / popup path can be tested without
  waiting for a real prayer time. The release manifest keeps both unexported.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service
            android:name=".AthanService"
            android:exported="true"
            tools:replace="android:exported" />
        <receiver
            android:name=".AthanReceiver"
            android:exported="true"
            tools:replace="android:exported" />
        <service
            android:name=".ReminderService"
            android:exported="true"
            tools:replace="android:exported" />
        <receiver
            android:name=".ReminderReceiver"
            android:exported="true"
            tools:replace="android:exported" />
    </application>

</manifest>
