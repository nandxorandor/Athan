    <string name="credits_row">Resources &amp; credits</string>
    <string name="credits_title">Resources &amp; credits</string>
    <string name="credits_intro">Where every athan included in this app came from. Most were published by IslamWeb (islamweb.net), which permits its material to be used for non-commercial purposes as long as the source is named. This app is free, carries no ads, and sells nothing.</string>
    <string name="credits_islamweb_permission">IslamWeb permission — fatwa no. 379009</string>
    <string name="credit_source">Source: %1$s</string>
    <string name="credit_source_unknown">Source: islamweb.net (reciter not named in the recording)</string>
    <string name="credit_own_recording">Recorded by the developer</string>
    <string name="credits_software">Software</string>
    <string name="credits_software_detail">Prayer times are calculated with the open-source “adhan” library by Batoul Apps. Everything the app shows — prayer times, the qibla, the athkar and the Ramadan calendar — is computed on your phone. The temperature is the only exception, and it can be switched off.</string>

