    <!-- Temperature. The only networked feature in the app; everything about
         its wording is meant to make that plain rather than bury it. -->
    <string name="temperature">Temperature</string>
    <string name="temperature_celsius">%1$d°C</string>
    <string name="temperature_fahrenheit">%1$d°F</string>
    <string name="temperature_enable">Show the temperature</string>
    <string name="temperature_explainer">The only part of Athan that uses the internet. Your coordinates are sent to Open-Meteo to look up the weather where you are — nothing else is sent, and nothing is stored. Turn this off and the app makes no network requests at all.</string>
    <string name="temperature_units">Units</string>
    <string name="unit_celsius">Celsius</string>
    <string name="unit_fahrenheit">Fahrenheit</string>
    <string name="temperature_summary_on">On · %1$s</string>
    <string name="temperature_summary_off">Off · no network requests</string>
    <string name="temperature_unit">Temperature unit</string>
    <string name="temperature_unit_summary">Shown on the home screen and when you tap it</string>
    <string name="reminder_volume">Heads-up volume</string>
    <string name="reminder_volume_summary">Separate from the athan volume</string>
    <string name="minutes_value">%1$d min</string>
    <string name="temperature_notice_title">Show the temperature?</string>
    <string name="temperature_notice_body">Athan can show the current temperature where you are. To do it, your coordinates are sent to Open-Meteo — that is the one and only thing this app ever sends anywhere.

Everything else — prayer times, the qibla, the athkar, the Ramadan calendar — is calculated on this phone and works with no connection at all.

You can change this any time in Settings.</string>
    <string name="temperature_notice_yes">Show it</string>
    <string name="temperature_notice_no">No, stay offline</string>
    <string name="credits_weather">Weather</string>
    <string name="credits_weather_detail">Temperature data by Open-Meteo.com, used under CC BY 4.0. Requested only while the temperature is switched on.</string>

