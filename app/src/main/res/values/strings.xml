    <string name="about_version">Version %1$s</string>
    <string name="about_developed_by">Developed by Ahmed Khalaf (A.K.)</string>
    <string name="about_contact">Contact</string>
    <string name="about_github">Follow me on GitHub: github.com/nandxorandor</string>
    <string name="about_audio_credit">Athan recordings</string>
    <string name="about_audio_credit_detail">Two of the bundled athans are my own recordings; the rest were published by IslamWeb and are included with the source named — see Settings → Resources &amp; credits. You can use any recording you prefer instead: Settings → Athan audio options.</string>
    <string name="about_privacy">No data is collected from this app. The one thing it ever sends is your coordinates, to look up the temperature — and only while that is switched on. Turn it off in Settings and the app makes no network requests at all.</string>
