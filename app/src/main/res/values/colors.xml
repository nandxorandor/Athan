<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0E1412</color>
    <color name="surface">#16201C</color>
    <color name="accent">#4FC79A</color>
    <color name="text">#E6EDEA</color>
    <color name="text_dim">#7C8A85</color>
    <!-- Sunrise is not a prayer, so it reads differently from the five: warm
         yellow rather than the green accent used for the next prayer. -->
    <color name="sunrise">#FFC93C</color>
    <!-- Unselected mode icons: visible enough to be tappable, quiet enough that
         the selected one is unmistakable. -->
    <color name="icon_idle">#46534E</color>

    <!-- Jumu'ah in the Ramadan table. The weekday name does not fit the column,
         so the one day that has to stand out does it with a tint. -->
    <color name="friday">#1B3B2E</color>

    <!-- Today, during the month. Brighter than the Friday tint and brighter
         than the banding, because on the day you are fasting this is the only
         row you are actually looking for. -->
    <!-- The not-yet-passed part of the next-prayer ring: there, but quiet. -->
    <!-- The iqama on the home screen: bright, and apart from the green of the
         athan's own time and the yellow of the label above it. -->
    <color name="iqama">#6CC8FF</color>
    <!-- The ring's quiet track while it counts to an iqama. -->
    <color name="ring_track_iqama">#1D3A4A</color>
    <color name="ring_track">#2A5444</color>
    <color name="today_row">#2E6B4F</color>
    <color name="today_text">#EAFBF3</color>

    <!-- The temperature reads brighter than the city beside it: it is the one
         live value on the screen, and the glow behind it says so. -->
    <color name="temperature_text">#8FE8C4</color>

    <!-- Compass. The classic red/pale needle pairing reads instantly as a
         compass, which a single-colour arrow does not. -->
    <color name="needle_head">#E5484D</color>
    <color name="needle_tail">#8A9A95</color>
    <color name="kaaba_body">#141414</color>
    <color name="kaaba_band">#E8C15A</color>
    <color name="warning_bg">#3A2A0E</color>
    <color name="warning_text">#F0C674</color>

    <!-- App volume slider — bright greens per the mockup. -->
    <color name="volume_label">#A6E22E</color>
    <color name="volume_green">#2FD968</color>

    <!-- Launcher-icon backdrop: the night-sky teal at the artwork's own border,
         so the parallax wobble never reveals a mismatched edge. -->
    <!-- Matches the artwork tile's own dark border, so the inset foreground
         reads as one icon rather than a picture floating on a coloured card. -->
    <color name="ic_launcher_bg">#181817</color>
</resources>
