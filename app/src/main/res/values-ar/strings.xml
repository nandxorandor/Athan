    <string name="credits_title">المصادر والشكر</string>
    <string name="credits_intro">مصدر كل أذان مضمَّن في هذا التطبيق. معظمها منشور على «إسلام ويب» (islamweb.net)، وهو يجيز استخدام مواده لأغراض غير تجارية ما دام المصدر مذكورًا. هذا التطبيق مجاني، ولا يحمل إعلانات، ولا يبيع شيئًا.</string>
    <string name="credits_islamweb_permission">إذن إسلام ويب — فتوى رقم 379009</string>
    <string name="credit_source">المصدر: %1$s</string>
    <string name="credit_source_unknown">المصدر: islamweb.net (اسم المؤذن غير مذكور في التسجيل)</string>
    <string name="credit_own_recording">تسجيل من إعداد المطوّر</string>
    <string name="credits_software">البرمجيات</string>
    <string name="credits_software_detail">تُحسب أوقات الصلاة بمكتبة «adhan» مفتوحة المصدر من Batoul Apps. وكل ما يعرضه التطبيق — مواقيت الصلاة والقبلة والأذكار وتقويم رمضان — يُحسب على هاتفك. ودرجة الحرارة هي الاستثناء الوحيد، ويمكن إيقافها.</string>

    <string name="about">عن التطبيق</string>
    <string name="about_version">الإصدار %1$s</string>
