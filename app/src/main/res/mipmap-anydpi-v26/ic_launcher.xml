<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground is the artwork itself, sized to the 72dp window the launcher
  actually draws; the background only shows during the parallax wobble, so it
  carries the artwork's own border colour. Themed (monochrome) icons get a
  separate silhouette — a photographic layer flattens to a blob when tinted.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
