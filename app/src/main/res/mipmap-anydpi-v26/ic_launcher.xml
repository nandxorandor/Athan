<?xml version="1.0" encoding="utf-8"?>
<!--
  The artwork is a finished tile with its own rounded border, so the foreground
  bitmap insets it to the centre 72dp of the 108dp canvas - the only part a
  launcher guarantees to draw. It used to fill all 108dp, which meant every
  launcher masked the border away and clipped the lettering. The background
  carries the artwork's own border colour so the two read as one icon. Themed
  (monochrome) icons get a separate silhouette - a photographic layer flattens
  to a blob when tinted.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
