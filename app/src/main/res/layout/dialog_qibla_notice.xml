<?xml version="1.0" encoding="utf-8"?>
<!--
  The checkbox only. The message goes through the dialog's own setMessage; keeping
  the checkbox out of that panel means it is always visible rather than something
  the user has to scroll to discover.
-->
<CheckBox xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dontShowAgain"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="4dp"
    android:text="@string/dont_show_again"
    android:textColor="@color/text_dim"
    android:textSize="14sp" />
