<?xml version="1.0" encoding="utf-8"?>
<!--
  One card per dhikr. Nothing here is ever ellipsised or scrolled sideways: the
  words are the point of the screen, so the card grows to fit them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_dhikr_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dhikrNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <!-- The repetition count is the one thing you need before you start
             reading, so it sits in the header rather than inside the text. -->
        <TextView
            android:id="@+id/dhikrRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_repeat_badge"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/dhikrText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="6dp"
        android:textColor="@color/text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/dhikrSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

</LinearLayout>
