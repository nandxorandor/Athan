<?xml version="1.0" encoding="utf-8"?>
<!-- One day. Suhoor and iftar are accented: they are what the fast turns on.
     Tapping the day adds or edits its note, which sits on a line beneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ramadanDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:textColor="@color/text_dim"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ramadanDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.7"
            android:textColor="@color/text"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ramadanSuhoor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.7"
            android:textColor="@color/accent"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ramadanDhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:textColor="@color/text"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ramadanAsr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:textColor="@color/text"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ramadanIftar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.7"
            android:textColor="@color/accent"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ramadanNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:drawablePadding="6dp"
        android:textColor="@color/sunrise"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
