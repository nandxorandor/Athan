<?xml version="1.0" encoding="utf-8"?>
<!-- One day. Suhoor and iftar are accented: they are what the fast turns on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/ramadanDay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:textColor="@color/text_dim"
        android:maxLines="1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ramadanDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.7"
        android:textColor="@color/text"
        android:maxLines="1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ramadanSuhoor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.7"
        android:textColor="@color/accent"
        android:maxLines="1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ramadanDhuhr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:textColor="@color/text"
        android:maxLines="1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ramadanAsr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:textColor="@color/text"
        android:maxLines="1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ramadanIftar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.7"
        android:textColor="@color/accent"
        android:maxLines="1"
        android:textSize="12sp" />

</LinearLayout>
