<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen, after a design a user sent in: the next prayer large in a
  ring, the day's table one tap away, a bottom bar for the other destinations.
  The ScrollView is only a safety net for short displays; the bar stays put
  below it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!--
              Shown only while an athan is actually sounding. The notification
              and the athan window both carry a Stop, but neither is guaranteed
              to be in front of you - Android 14 lets an ongoing notification be
              swiped away, and the window can be dismissed with Back. Without
              this, the app you open to stop the sound looks exactly like an app
              with nothing playing.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopAthanBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:visibility="gone"
                app:icon="@drawable/ic_athan"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <!-- City at the start, temperature at the end. The pin and the
                 arrow mark the city as the control that changes the location. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- A packed chain: the arrow follows the name however long it
                     is, and the name takes all the room the temperature leaves
                     before it ellipsizes, instead of stopping at a fixed width. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/locationRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/cityPin"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/set_location"
                        android:src="@drawable/ic_place"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cityName"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/accent" />

                    <TextView
                        android:id="@+id/cityName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/set_location"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cityChevron"
                        app:layout_constraintStart_toEndOf="@id/cityPin"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/cityChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cityName"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Gone until a reading actually arrives, so a failed fetch
                     leaves no empty gap. -->
                <TextView
                    android:id="@+id/temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_temperature"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/temperature_text"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/hijriDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:textColor="@color/sunrise"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/gregorianDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <!-- The full-timetable layout's one-line countdown. -->
            <TextView
                android:id="@+id/nextPrayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/no_location_yet"
                android:textColor="@color/accent"
                android:textSize="22sp" />

            <!-- The next prayer and how long until it, large enough to read
                 across a room. Tapping it opens the day's table. The ring's
                 size here is only a starting point: MainActivity fits it to
                 the room the screen actually has, and shrinks the text inside
                 to fit the ring, so a small screen or a large font setting
                 still shows the buttons below. -->
            <FrameLayout
                android:id="@+id/nextCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <com.ahmedkhalaf.athan.NextPrayerRing
                    android:id="@+id/nextRing"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:id="@+id/nextInner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/next_prayer_label"
                        android:textColor="@color/text_dim"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/nextName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time_left"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />

                    <!-- Tabular digits, so the line does not twitch every
                         second as a 1 gives way to a wider 0. -->
                    <TextView
                        android:id="@+id/nextCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:textColor="@color/text"
                        android:textDirection="ltr"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/accent" />

                    <TextView
                        android:id="@+id/nextTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/nextIqama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/alarmWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/warning_bg"
                android:padding="12dp"
                android:text="@string/exact_alarm_blocked"
                android:textColor="@color/warning_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- The full-timetable layout's table. -->
            <LinearLayout
                android:id="@+id/timesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/allTimesButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_list"
                    app:tint="@color/accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/all_times"
                    android:textColor="@color/accent"
                    android:textSize="17sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_forward"
                    app:tint="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qiblaButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:text="@string/qibla"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_explore"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/accent"
                    app:strokeColor="@color/icon_idle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ramadanButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/ramadan"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_adhkar_evening"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/text"
                    app:strokeColor="@color/icon_idle" />
            </LinearLayout>

            <!-- Evening first, morning second, in the order users already know;
                 the icons carry the time of day so neither label has to. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/eveningAdhkarButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/adhkar_evening"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    app:autoSizeMaxTextSize="15sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_adhkar_evening"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/text"
                    app:strokeColor="@color/icon_idle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/morningAdhkarButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/adhkar_morning"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    app:autoSizeMaxTextSize="15sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_adhkar_morning"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/sunrise"
                    app:strokeColor="@color/icon_idle" />
            </LinearLayout>

            <!-- The language switch stays on the home screen rather than inside
                 Settings: an Arabic reader who opens an English app should not
                 have to read English to find it. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/languageGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/langEnglish"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/lang_english"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/langArabic"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/lang_arabic"
                    android:textAllCaps="false"
                    android:textSize="14sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemActiveIndicatorStyle="@style/HomeNavIndicator"
        app:itemIconTint="@color/home_nav_item"
        app:itemTextColor="@color/home_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/home_nav" />
</LinearLayout>
