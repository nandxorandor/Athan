<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything here has to fit one screen without scrolling. Anything that is not
  "what time is the next prayer and how will it announce itself" belongs in
  SettingsActivity. The ScrollView is only a safety net for short displays.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!--
          Shown only while an athan is actually sounding. The notification and
          the athan window both carry a Stop, but neither is guaranteed to be
          in front of you - Android 14 lets an ongoing notification be swiped
          away, and the window can be dismissed with Back. Without this, the
          app you open to stop the sound looks exactly like an app with
          nothing playing.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopAthanBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:visibility="gone"
            app:icon="@drawable/ic_athan"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <LinearLayout
            android:id="@+id/locationRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- A pin instead of the word "Change": it signals the row is the
                 location control while leaving the full width to city names
                 like "St. Mary's County", which the label used to truncate. -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/set_location"
                android:src="@drawable/ic_place"
                app:tint="@color/accent" />

            <TextView
                android:id="@+id/cityName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/set_location"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <!-- Rides on the location row rather than taking a line of its
                 own: it belongs to the place, and the home screen has no
                 vertical room to spare. Gone until a reading actually
                 arrives, so a failed fetch leaves no empty gap. -->
            <TextView
                android:id="@+id/temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_temperature"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingTop="5dp"
                android:paddingEnd="7dp"
                android:paddingBottom="5dp"
                android:textColor="@color/temperature_text"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/hijriDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textColor="@color/sunrise"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nextPrayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/no_location_yet"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/alarmWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/warning_bg"
            android:padding="12dp"
            android:text="@string/exact_alarm_blocked"
            android:textColor="@color/warning_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/timesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qiblaButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/qibla"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:icon="@drawable/ic_explore"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="20dp" />
        </LinearLayout>

        <!-- Evening on the left, morning on the right: the row reads
             right-to-left like the Arabic on the buttons themselves, and the
             icons carry the time of day so neither label has to. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/eveningAdhkarButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/adhkar_evening"
                android:textAllCaps="false"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:icon="@drawable/ic_adhkar_evening"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="20dp"
                app:iconTint="@color/text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morningAdhkarButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/adhkar_morning"
                android:textAllCaps="false"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:icon="@drawable/ic_adhkar_morning"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="20dp"
                app:iconTint="@color/sunrise" />
        </LinearLayout>

        <!-- The language switch sits on the home screen rather than inside
             Settings: an Arabic reader who opens an English app should not have
             to read English to find it. -->
        <!-- The language switch and the Ramadan calendar share the last row.
             The switch stays a two-segment pill and the calendar is an
             ordinary button, so the calendar never reads as a third language. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/languageGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.35"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langEnglish"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/lang_english"
                android:textAllCaps="false"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langArabic"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/lang_arabic"
                android:textAllCaps="false"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ramadanButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/ramadan_short"
                android:textAllCaps="false"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
